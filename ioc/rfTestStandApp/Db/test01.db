# ----------- dummy motor -------------------

record(ao, "Motor:Pos:Set") {
    field(OMSL, "supervisory")
    field(FLNK, "Motor:Pos:Sel_")
}

record(seq, "Motor:Pos:Sel_") {
    field(LNK0, "Motor:Running PP")
    field(DO0, "1")
    field(DLY0, "0")
    field(LNK1, "Motor:Pos:Read PP")
    field(DLY1, "3")
}

record(bi, "Motor:Running") {
    field(ONAM, "Running")
    field(ZNAM, "Stopped")
}

record(ai, "Motor:Pos:Read") {
    field(INP, "Motor:Pos:Set")
    field(FLNK, "Motor:Pos:Sel2_")
}

record(seq, "Motor:Pos:Sel2_") {
    field(LNK0, "Motor:Running PP")
    field(DO0, "0")
    field(DLY0, "0")
}
